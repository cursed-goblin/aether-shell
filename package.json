{
  "name": "aether-shell",
  "version": "0.1.0",
  "description": "A glassmorphic Wayland desktop shell built with Astal/AGS (GTK4), with a built-in AI agent driven by your own API keys.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "ags run . --gtk4",
    "bundle": "ags bundle app.ts dist/aether-shell --gtk4",
    "types": "ags types -d @girs",
    "check": "tsc --noEmit",
    "fmt": "prettier --write \"**/*.{ts,tsx,scss,json,md}\""
  },
  "dependencies": {
    "astal": "^0.1.0"
  },
  "devDependencies": {
    "@girs/gjs": "^4.0.0-beta.16",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0"
  }
}
